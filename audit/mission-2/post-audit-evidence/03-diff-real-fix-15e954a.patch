new file mode 100644
index 0000000..901f6a7
--- /dev/null
+++ b/src/components/MathText.tsx
@@ -0,0 +1,30 @@
+import React from 'react';
+import { splitMathSegments } from '../utils/mathBidi';
+
+/**
+ * MathText — رندر متن ترکیبیِ «فارسی + عبارت ریاضی» با جهت درست.
+ *
+ * متن فارسی اطراف عادی و RTL رندر می‌شود؛ هر قطعهٔ خالص ریاضی (تشخیص در
+ * utils/mathBidi) در یک span با `dir="ltr"` و `unicode-bidi: isolate` رندر
+ * می‌شود تا ترتیب استاندارد ریاضی حفظ شود، بدون تغییر محتوا، ارقام فارسی یا
+ * ترتیب داده. جایگزینِ جابه‌جایی دستی اعداد و عملگرهاست.
+ *
+ * استفاده: <MathText text={question.prompt} /> — یا با استایل اضافی:
+ * <MathText text={...} className="font-bold" />
+ */
+export const MathText: React.FC<{ text: string; className?: string }> = ({ text, className }) => {
+  const segments = splitMathSegments(text);
+  return (
+    <span className={className}>
+      {segments.map((seg, i) =>
+        seg.kind === 'math' ? (
+          <span key={i} dir="ltr" className="math-iso">
+            {seg.value}
+          </span>
+        ) : (
+          <React.Fragment key={i}>{seg.value}</React.Fragment>
+        ),
+      )}
+    </span>
+  );
+};
