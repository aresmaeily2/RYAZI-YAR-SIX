@@ -0,0 +1,84 @@
+/**
+ * mathBidi — جداسازی جهت‌نمایش عبارت‌های ریاضی داخل متن فارسی (لایهٔ نمایش؛ بدون تغییر محتوا)
+ *
+ * مسئله: سند `dir="rtl"` است؛ اعداد فارسی (کلاس bidi: EN) به‌صورت واحدهای مستقل
+ * رندر می‌شوند و عملگرهای × ÷ = < > (کلاس Neutral) در جریان RTL جهت می‌گیرند؛
+ * نتیجه: «۱۰−۲×۳» به‌صورت «۳ × ۱۰−۲» دیده می‌شود.
+ *
+ * راه‌حل ریشه‌ای: تشخیص قطعه‌های «خالص ریاضی» (فقط رقم/عملگر/پرانتز/جداکننده — بدون
+ * حرف فارسی) و رندر آن‌ها در span با `dir="ltr"` + `unicode-bidi: isolate`؛ متن
+ * فارسی اطراف RTL می‌ماند، ارقام فارسی و ترتیب منطقی داده دست‌نخورده می‌ماند و
+ * هیچ بازچینشی روی داده انجام نمی‌شود.
+ *
+ * قاعده‌های محافظه‌کارانه (برای اینکه متنی که درست رندر می‌شود خراب نشود):
+ *  - قطعهٔ «عدد + علامت پایانی» (قرارداد نگارشی «۳−» در داده) جداسازی نمی‌شود؛
+ *    در RTL همین امروز منفیِ دیداری سمت چپ می‌نشیند (استاندارد).
+ *  - کسر «۳/۴»، اعشار «۷۸٫۵»، درصدها و اعداد تنها جداسازی نمی‌شوند (تک‌ران‌اند).
+ *  - جداسازی فقط با وجود عملگر بین دو عدد، یا علامت ابتدایی پیش از عدد، یا
+ *    پرانتزِ باز-بسته همراه رقم انجام می‌شود.
+ */
+
+/** گونهٔ هر قطعه: متن عادی (همان‌طور رندر شود) یا ریاضی (رندر LTR ایزوله) */
+export interface MathSegment {
+  kind: 'text' | 'math';
+  value: string;
+}
+
+/*
+ * کاراکترهای مجاز داخل یک قطعهٔ ریاضی — ترتیبِ نوشتار کلاس مهم است:
+ * خط تیرهٔ ASCII در انتهای کلاس تا به‌عنوان بازه تفسیر نشود.
+ */
+const MATH_RUN = /[0-9\u06F0-\u06F9\u0660-\u0669\u00B9\u00B2\u00B3a-zA-Z×÷=≠<>≤≥±^≈·/.٫()[\]\u060C+\u2212\u2013\s-]+/g;
+
+/** حداقل یک رقم دارد؟ */
+const HAS_DIGIT = /[0-9\u06F0-\u06F9\u0660-\u0669\u00B9\u00B2\u00B3]/;
+
+/** عملگر «بین» دو عدد (یا پیش از پرانتز) */
+const OP_BETWEEN = /[0-9\u06F0-\u06F9\u0660-\u0669\u00B9\u00B2\u00B3]\s*[+×÷=≠<>≤≥±^≈\u2212\u2013-]\s*[0-9\u06F0-\u06F9\u0660-\u0669\u00B9\u00B2\u00B3(]/;
+
+/** علامت ابتدایی پیش از عدد (منفی/مثبتِ آغاز عبارت) */
+const LEADING_SIGN = /^[+\u2212\u2013-]\s*[0-9\u06F0-\u06F9\u0660-\u0669\u00B9\u00B2\u00B3(]/;
+
+/** پرانتز باز-بستهٔ هم‌زوج همراه رقم (فارسی/عربی/لاتین) داخل */
+const PAREN_PAIR = /\([^)]*[0-9\u06F0-\u06F9\u0660-\u0669][^)]*\)|\[[^\]]*[0-9\u06F0-\u06F9\u0660-\u0669][^\]]*\]/;
+
+/** قرارداد نگارشی «۳−» یا «(۲−)» — عدد و فقط علامت پایانی؛ جداسازی نمی‌شود */
+const TRAILING_SIGN_ONLY = /^\(?[0-9\u06F0-\u06F9\u0660-\u0669\u00B9\u00B2\u00B3]+\s*[+\u2212\u2013-]\s*\)?$/;
+
+/** آیا قطعه واقعاً «عبارت ریاضی» است و جداسازی آن را بهتر نشان می‌دهد؟ */
+export function isMathRun(run: string): boolean {
+  if (!HAS_DIGIT.test(run)) return false;
+  if (TRAILING_SIGN_ONLY.test(run.trim())) return false;
+  return OP_BETWEEN.test(run) || LEADING_SIGN.test(run.trim()) || PAREN_PAIR.test(run);
+}
+
+/**
+ * متن را به قطعه‌های «text» (رندر عادی RTL) و «math» (رندر LTR ایزوله) می‌شکند.
+ * محتوای کاراکترها عیناً حفظ می‌شود؛ فاصله‌های لبهٔ قطعهٔ ریاضی به متن اطراف می‌روند.
+ */
+export function splitMathSegments(text: string): MathSegment[] {
+  const segments: MathSegment[] = [];
+  const pushText = (value: string) => {
+    if (value.length > 0) segments.push({ kind: 'text', value });
+  };
+  let last = 0;
+  for (const m of text.matchAll(MATH_RUN)) {
+    const run = m[0];
+    const start = m.index ?? 0;
+    if (!isMathRun(run)) continue;
+    const lead = run.length - run.trimStart().length;
+    let trail = run.length - run.trimEnd().length;
+    // نقطهٔ پایانیِ جمله (پس از هستهٔ عبارت، فاصله یا پایان متن) جزء عبارت ریاضی نیست — به متن RTL برمی‌گردد
+    const core = run.slice(lead, run.length - trail);
+    const afterCore = text[start + run.length - trail];
+    if (core.endsWith('.') && (afterCore === undefined || /\s/.test(afterCore))) {
+      trail += 1;
+    }
+    pushText(text.slice(last, start) + run.slice(0, lead));
+    segments.push({ kind: 'math', value: run.slice(lead, run.length - trail) });
+    if (trail > 0) pushText(run.slice(run.length - trail));
+    last = start + run.length;
+  }
+  if (last < text.length) pushText(text.slice(last));
+  return segments;
+}
