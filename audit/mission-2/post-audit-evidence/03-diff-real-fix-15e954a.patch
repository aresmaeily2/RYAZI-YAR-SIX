index 0000000..f4842cd
--- /dev/null
+++ b/tests/mathBidiRendering.test.tsx
@@ -0,0 +1,230 @@
+import { describe, expect, it } from 'vitest';
+import { render } from '@testing-library/react';
+import { isMathRun } from '../src/utils/mathBidi';
+import { MathText } from '../src/components/MathText';
+import { QuestionCard } from '../src/components/QuestionCard';
+import type { McqQuestion } from '../src/types/curriculum';
+
+/**
+ * آزمون‌های جهت و ترتیب نمایش ریاضی در محیط RTL (مأموریت اصلاحی مالک).
+ *
+ * هدف: هیچ عبارت ریاضی داخل متن فارسی نباید به‌خاطر الگوریتم bidi ترتیب
+ * استاندارد ریاضی خود را از دست بدهد. راه‌حل ریشه‌ای: قطعه‌های خالص ریاضی در
+ * <span dir="ltr" class="math-iso"> رندر می‌شوند (unicode-bidi: isolate)؛ متن
+ * فارسی اطراف RTL می‌ماند؛ محتوا بایت‌به‌بایت حفظ می‌شود.
+ */
+
+/** محتوای متنی رندرشده باید عیناً همان ورودی باشد — هیچ کاراکتری اضافه/کم نمی‌شود */
+function expectContentPreserved(text: string) {
+  const { container } = render(<MathText text={text} />);
+  expect(container.textContent).toBe(text);
+}
+
+/** قطعه‌های math باید در span با dir="ltr" باشند */
+function mathSpans(text: string): HTMLElement[] {
+  const { container } = render(<MathText text={text} />);
+  return Array.from(container.querySelectorAll('span[dir="ltr"]'));
+}
+
+describe('mathBidi — تشخیص قطعهٔ ریاضی (نگرانی‌های محافظه‌کارانه)', () => {
+  it('عبارت چندعملگری استاندارد ریاضی است', () => {
+    expect(isMathRun('۱۰−۲×۳')).toBe(true);
+    expect(isMathRun('۱۰ − ۲ × ۳')).toBe(true);
+  });
+
+  it('عدد تنها، کسر، اعشار و درصد جداسازی نمی‌شوند (تک‌ران و بی‌نیاز)', () => {
+    expect(isMathRun('۱۵')).toBe(false);
+    expect(isMathRun('۳/۴')).toBe(false);
+    expect(isMathRun('۷۸٫۵')).toBe(false);
+    expect(isMathRun('۱٬۲۰۰')).toBe(false);
+  });
+
+  it('قرارداد نگارشی «۳−» (عدد + علامت پایانی) جداسازی نمی‌شود تا منفیِ دیداری سمت چپ بماند', () => {
+    expect(isMathRun('۳−')).toBe(false);
+    expect(isMathRun('(۲−)')).toBe(false);
+  });
+
+  it('متن فارسی با حروف، قطعهٔ ریاضی نمی‌شود', () => {
+    expect(isMathRun('اختلاف ثابت × شماره شکل')).toBe(false); // حروف فارسی ران را می‌شکنند
+    expect(isMathRun('فصل')).toBe(false);
+  });
+
+  it('زوج مرتب پرانتزدار شناسایی می‌شود', () => {
+    expect(isMathRun('(۲، ۳)')).toBe(true);
+  });
+
+  it('منفیِ ابتدای عبارت شناسایی می‌شود', () => {
+    expect(isMathRun('−۸ + ۳')).toBe(true);
+  });
+});
+
+describe('mathBidi — ۹ عبارت مرزی مالک: حفظ محتوا + جداسازی درست', () => {
+  const ownerCases: Array<[string, boolean]> = [
+    ['۱۰ − ۲ × ۳', true],
+    ['۵ + (۶ × ۲) − (۴ ÷ ۲)', true],
+    ['−۸ + ۳', true],
+    ['۱۲ ÷ ۳ = ۴', true],
+    ['۱٫۵ + ۲٫۵', true],
+    ['۳/۴ + ۱/۴', true],
+    ['۲³', false], // تک‌ران EN؛ بدون جداسازی هم ترتیب درست دارد
+    ['۵ < ۸', true],
+    ['(۲، ۳)', true],
+  ];
+
+  for (const [expr, shouldIsolate] of ownerCases) {
+    it(`«${expr}» — محتوا عیناً حفظ می‌شود`, () => {
+      expectContentPreserved(expr);
+    });
+
+    it(`«${expr}» — ${shouldIsolate ? 'در span LTR ایزوله رندر می‌شود' : 'بدون جداسازی (تک‌ران بی‌نیاز)'}`, () => {
+      const spans = mathSpans(expr);
+      if (shouldIsolate) {
+        expect(spans.length).toBe(1);
+        expect(spans[0].textContent).toBe(expr);
+      } else {
+        expect(spans.length).toBe(0);
+      }
+    });
+  }
+});
+
+describe('mathBidi — متن فارسی اطراف و ترکیب‌های واقعی محصول', () => {
+  it('متن فارسی خالی از عبارت ریاضی، بدون هیچ span اضافه رندر می‌شود', () => {
+    const text = 'به این سؤال پاسخ ندادی.';
+    const spans = mathSpans(text);
+    expect(spans.length).toBe(0);
+    expectContentPreserved(text);
+  });
+
+  it('جملهٔ ترکیبی: فقط عبارت ریاضی ایزوله می‌شود و بقیه متن عادی می‌ماند', () => {
+    const text = 'با قرارداد، اول ضرب: ۳×۲=۶؛ سپس تفریق: ۱۰−۶=۴.';
+    const spans = mathSpans(text);
+    expect(spans.length).toBe(2);
+    expect(spans[0].textContent).toBe('۳×۲=۶');
+    expect(spans[1].textContent).toBe('۱۰−۶=۴');
+    expectContentPreserved(text);
+  });
+
+  it('سربرگ نمونهٔ C — «حاصل ۱۰−۲×۳ چند است؟»', () => {
+    const text = 'حاصل ۱۰−۲×۳ چند است؟';
+    const spans = mathSpans(text);
+    expect(spans.length).toBe(1);
+    expect(spans[0].textContent).toBe('۱۰−۲×۳');
+    expectContentPreserved(text);
+  });
+
+  it('چیپ گام B4 — «گام ۱ انجام شد: ۲×۳=۶»', () => {
+    const text = 'گام ۱ انجام شد: ۲×۳=۶';
+    const spans = mathSpans(text);
+    expect(spans.length).toBe(1);
+    expect(spans[0].textContent).toBe('۲×۳=۶');
+    expectContentPreserved(text);
+  });
+
+  it('فرمول‌باکس دارای کلمات فارسی — کلمات جداسازی نمی‌شوند (رفع خرابی ترتیب کلمات)', () => {
+    const text = 'جمله nام = (اختلاف ثابت × شماره شکل) + مقدار تنظیم‌کننده';
+    const spans = mathSpans(text);
+    // هیچ قطعهٔ «خالص ریاضی» در این رشته وجود ندارد — کلمات فارسی ران‌ها را می‌شکنند
+    expect(spans.length).toBe(0);
+    expectContentPreserved(text);
+  });
+
+  it('فرمول‌باکس ترکیبی (متن فارسی + عبارت خالص در انتها)', () => {
+    const text = 'فاصله دو عدد روی محور = اختلاف قدرمطلق آن‌ها | ۵− + ۸ = ۳+';
+    const spans = mathSpans(text);
+    expect(spans.length).toBe(1);
+    expect(spans[0].textContent).toBe('۵− + ۸ = ۳+');
+    expectContentPreserved(text);
+  });
+
+  it('خط محاسبهٔ آزمایشگاه استوانه', () => {
+    const text = '۴ × ۴ × ۳/۱۴ = ۵۰٫۲۴';
+    const spans = mathSpans(text);
+    expect(spans.length).toBe(1);
+    expect(spans[0].textContent).toBe('۴ × ۴ × ۳/۱۴ = ۵۰٫۲۴');
+    expectContentPreserved(text);
+  });
+
+  it('جمع‌بندی نمونهٔ A — زنجیرهٔ عبارت‌ها یک قطعهٔ LTR می‌شود', () => {
+    const text = 'ترتیب را دیدی و با نماد نوشتیم: قرارداد یعنی ۵+(۶×۲)−(۴÷۲) = ۵+۱۲−۲ = ۱۵. حالا در تمرین‌ها اول «عمل اول» را پیدا کن.';
+    const spans = mathSpans(text);
+    expect(spans.length).toBe(1);
